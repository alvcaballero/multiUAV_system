# CONTRATO de mensajes ROS 2 Jazzy del sistema. Lo heredan bridge:jazzy, dev:jazzy y los dispositivos Jazzy
# (devices/px4_ros2 lo importa con vcs). Un mensaje nuevo se declara AQUÍ y solo aquí.
# Versiones fijadas por COMMIT, nunca por rama (decisión 12). El comentario dice de qué rama sale cada commit.
#   vcs import ws/jazzy/src < images/msgs/jazzy.repos
#
# Sin psdk_ros2: el M300 (PSDK) es solo Humble (decisión 16).
repositories:
  # Contrato PX4 Jazzy (decisión 19): main @6cdc4f5 = msg/ y srv/ de PX4 f629d451 (v1.18.0-beta1-948), idénticos byte
  # a byte (verificado). Es lo que escucha el GCS (px4_ros2.yaml): vehicle_status_v4, battery_status_v1,
  # vehicle_local_position_v1, vehicle_command_ack_v1. NO main a secas: el 2026-10-30 pasó a VehicleStatus v5.
  # Otro PX4 a bordo → translation node compilado de ese mismo PX4 (devices/px4_ros2/px4.env).
  px4_msgs:
    type: git
    url: https://github.com/PX4/px4_msgs.git
    version: 6cdc4f55d1ce924848905fd63cacdd1bf17f9060   # main

  # muav_gcs_interfaces: MISMO commit que humble.repos: el GCS tiene una sola definición.
  MUAV_GCS_interfaces:
    type: git
    url: https://github.com/arpoma16/MUAV_GCS_interfaces.git
    version: 59ebddf7a8ae7bc48241018f9880d75d57f4d307   # main
