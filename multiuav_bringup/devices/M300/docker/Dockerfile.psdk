FROM ros-humble:l4t-r36.4.0

ARG DEBIAN_FRONTEND=noninteractive

# Deps del sistema necesarias para PSDK
RUN apt-get update && apt-get install -y --no-install-recommends \
    automake \
    autoconf \
    libtool \
    pkg-config \
    nasm \
    yasm \
    nlohmann-json3-dev \
    libgtk-3-dev \
    libpng-dev \
    libjpeg-dev \
    libtiff-dev \
    libeigen3-dev \
    libatlas-base-dev \
    gfortran \
    libusb-1.0-0-dev \
    libaio-dev \
    ros-humble-camera-info-manager \
    ros-humble-image-pipeline \
    ros-humble-geographic-info \
    ros-humble-robot-localization \
    ros-humble-rc-common-msgs \
    && rm -rf /var/lib/apt/lists/*

# Opus 1.3.1 desde fuente (requerido por DJI PSDK para audio)
RUN git clone -b v1.3.1 https://gitlab.xiph.org/xiph/opus.git && \
    cd opus && \
    autoreconf -f -i && \
    ./configure --prefix=/usr/local && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd .. && rm -rf opus

# FFmpeg 4.3.2 desde fuente con soporte opus (mínimo necesario para PSDK)
# --enable-libopusfile NO es un flag válido de FFmpeg; se usa solo --enable-libopus
RUN git clone -b n4.3.2 https://github.com/FFmpeg/FFmpeg.git && \
    cd FFmpeg && \
    ./configure \
        --prefix=/usr/local \
        --enable-shared \
        --disable-static \
        --enable-gpl \
        --enable-libopus \
        --pkg-config-flags="--static" && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    cd .. && rm -rf FFmpeg

# psdk_ros2 (wrapper ROS2), as2-platform-dji-psdk y aerostack2 desde apt
# Evita compilar desde fuente y los problemas de rosdep con paquetes del workspace
# https://umdlife.github.io/psdk_ros2/documentation/RunningTheWrapper.html
# https://aerostack2.github.io/_03_aerial_platforms/_dji_psdk/index.html#install-platform-package
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-psdk-wrapper \
    ros-humble-psdk-interfaces \
    ros-humble-as2-platform-dji-psdk \
    && rm -rf /var/lib/apt/lists/*

# --- DJI Payload SDK 3.9.2 ---
# El wrapper de apt (psdk_ros2) necesita el Payload-SDK en una ruta conocida
RUN mkdir -p /opt/payload-sdk && \
    git clone --depth 1 -b 3.9.2 https://github.com/dji-sdk/Payload-SDK.git \
    /opt/payload-sdk

ENV PSDK_APP_NAME=""
ENV PSDK_APP_ID=""
ENV PSDK_APP_KEY=""
ENV PSDK_APP_LICENSE=""
ENV PSDK_DEVELOPER_ACCOUNT=""
ENV PSDK_BAUD_RATE="460800"

RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

COPY entrypoint_psdk.sh /root/entrypoint_psdk.sh
RUN chmod +x /root/entrypoint_psdk.sh

WORKDIR /root
ENTRYPOINT ["/root/entrypoint_psdk.sh"]
CMD ["bash"]
