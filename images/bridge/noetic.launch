<!--
  Bridge ROS 1 del GCS: multimaster (descubre y sincroniza los masters de los drones) + rosbridge (WebSocket :9090).
  Reemplaza a connect_uas.launch (decisión 10). La lanza images/bridge/start.sh.

  hosts: los DRONES, separados por coma (ver multimaster.launch). Por defecto, $MUAV_HOSTS.
-->
<launch>
  <arg name="hosts" default="$(optenv MUAV_HOSTS)"/>
  <arg name="multimaster" default="true"/>

  <include if="$(arg multimaster)" file="$(dirname)/multimaster.launch">
    <arg name="hosts" value="$(arg hosts)"/>
  </include>

  <include file="$(find rosbridge_server)/launch/rosbridge_websocket.launch"/>
</launch>
