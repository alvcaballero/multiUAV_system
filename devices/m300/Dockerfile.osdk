# M300 por OSDK (Jetson Orin Nano, L4T r36.4, arm64). Cadena: Dockerfile.opencv → Dockerfile.ros1 → este.
# Build context: la RAÍZ del repo (container_build.sh), para leer el contrato images/msgs/noetic.repos.
#
# OSDK = ROS 1 Noetic, y solo Noetic (desde fuentes: Noetic no tiene apt para Jammy, ver Dockerfile.ros1).
# Workspace /root/app_ws: versiones del contrato (images/msgs/noetic.repos) + propios (devices/m300/noetic.repos).
# Se compila SOLO lo que piden los paquetes del M300 (--only-pkg-with-deps), igual que el perfil PSDK.
ARG IMAGE_NAME=ros-noetic:l4t-r36.4.0
FROM ${IMAGE_NAME}

ARG DEBIAN_FRONTEND=noninteractive
# Onboard-SDK: librería CMake (no catkin) que necesita dji_osdk_ros COMPLETO. master @ 4.1.0-34.
ARG OSDK_VERSION=118e2825a347499efb8ed253146552c5b9b10779
# Paquetes raíz del M300: se compilan ellos y sus dependencias del workspace, nada más.
#   onboard_dji (misión, arrastra dji_osdk_ros + aerialcore_common), simple_vs + ros_rtsp (vídeo), multimaster.
ARG DEVICE_PACKAGES="onboard_dji simple_vs ros_rtsp fkie_master_discovery fkie_master_sync"

# 1. Herramientas del sistema (Ubuntu 22.04)
RUN apt-get update && apt-get install -y \
    nano \
    sudo \
    curl \
    gnupg2 \
    git \
    cmake \
    build-essential \
    libusb-1.0-0-dev \
    ffmpeg \
    libavcodec-dev \
    libssl-dev \
    libswresample-dev \
    libsdl2-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-good1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    libgstrtspserver-1.0-dev \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-rtsp \
    libqt5websockets5-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Noetic lo necesita
RUN ln -s /usr/bin/python3 /usr/bin/python || true

# 2. DJI Onboard-SDK (fijado), común a los dispositivos OSDK.
COPY devices/common/osdk/install_osdk.sh /tmp/install_osdk.sh
RUN /tmp/install_osdk.sh ${OSDK_VERSION}

# 3. Workspace: contrato + paquetes propios del M300.
# Sin grpcio: lo pedía fkie_node_manager_daemon, que ya no se compila (discovery + sync solo dependen de
# fkie_multimaster_msgs).
WORKDIR /root/app_ws
# Mismo nombre en origen (noetic.repos): se copian con el nombre de su rol para no pisarse.
COPY images/msgs/noetic.repos /root/app_ws/repos/contract.repos
COPY devices/m300/noetic.repos /root/app_ws/repos/device.repos
RUN mkdir -p src/external \
    && vcs import --input repos/contract.repos src \
    && vcs import --input repos/device.repos src

SHELL ["/bin/bash", "-c"]
# OpenCV_DIR: el OpenCV CUDA de Dockerfile.opencv, no el de pip.
# dji_osdk_ros va COMPLETO (sin ONBOARD_SDK_ROS_ONLY_INTERFACES): aquí sí está el Onboard-SDK.
RUN source /root/catkin_ws/install/setup.bash && \
    catkin_make --only-pkg-with-deps ${DEVICE_PACKAGES} \
                -DCATKIN_ENABLE_TESTING=OFF -j4 \
                -DOpenCV_DIR=/usr/local/lib/cmake/opencv4

RUN echo "source /root/app_ws/devel/setup.bash" >> /root/.bashrc

# Multimaster del dron: el mismo launch que bridge:noetic, con los hosts del GCS por MUAV_HOSTS.
COPY images/bridge/multimaster.launch /opt/muav/multimaster.launch

# DJI MatriceSeries ConfigTool. La config REAL (credenciales) se monta en /root/cfg (container_run.sh).
RUN echo 'SIM_LAT=37.1939871' >> /root/.bashrc && \
    echo 'SIM_LON=-6.7032891' >> /root/.bashrc && \
    echo 'alias M300-real="/root/Onboard-SDK/utility/bin/armv8/64-bit/MatriceSeries_ConfigTool --usb-port /dev/ttyACM0 --config-file /root/cfg/UserConfig_osdk.txt --power-supply on"' >> /root/.bashrc && \
    echo 'alias M300-sim-on="/root/Onboard-SDK/utility/bin/armv8/64-bit/MatriceSeries_ConfigTool --usb-port /dev/ttyACM0 --config-file /root/cfg/UserConfig_osdk.txt --power-supply on --usb-connected-flight on --simulation on --latitude $SIM_LAT --longitude $SIM_LON"' >> /root/.bashrc

COPY devices/common/osdk/entrypoint_osdk.sh /root/entrypoint_osdk.sh
RUN chmod +x /root/entrypoint_osdk.sh

WORKDIR /root/app_ws
ENTRYPOINT ["/root/entrypoint_osdk.sh"]
CMD ["bash"]
