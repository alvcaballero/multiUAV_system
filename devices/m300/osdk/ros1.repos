  rosconsole:             {type: git, url: https://github.com/ros/rosconsole.git,             version: 1.14.3}
  rosconsole_bridge:      {type: git, url: https://github.com/ros/rosconsole_bridge.git,      version: 0.5.4}
  roscpp_core:            {type: git, url: https://github.com/ros/roscpp_core.git,            version: 0.7.2}
  roslisp:                {type: git, url: https://github.com/ros/roslisp.git,                version: 1.9.25}
  rospack:                {type: git, url: https://github.com/ros/rospack.git,                version: 2.6.2}
  std_msgs:               {type: git, url: https://github.com/ros/std_msgs.git,               version: 0.5.13}
  roslint:                {type: git, url: https://github.com/ros/roslint.git,                version: 0.12.0}
