# Red del HOST del M210 (Raspberry Pi): /etc/netplan/50-cloud-init.yaml. Origen: multiuav_bringup/devices/M210/50-cloud-init.yaml.
# Contraseñas WiFi reemplazadas por <WIFI_PASSWORD>: las reales NUNCA a git (estaban commiteadas: ver el plan).
#   sudo cp netplan.yaml.example /etc/netplan/50-cloud-init.yaml   # completar contraseñas
#   sudo netplan apply
#
# This file is generated from information provided by the datasource.  Changes
# to it will not persist across an instance reboot.  To disable cloud-init's
# network configuration capabilities, write a file
# /etc/cloud/cloud.cfg.d/99-disable-network-config.cfg with the following:
# network: {config: disabled}
network:
  version: 2
  renderer: networkd
  ethernets:
    eth0:
      dhcp4: no
      optional: true
      addresses:
        - 10.42.0.43/24
      routes:
        - to: 0.0.0.0/0
          via: 10.42.0.1 #2
          metric: 100 # Mayor prioridad para Ethernet
      nameservers:
        addresses: [8.8.8.8]
    usb0:
      dhcp4: no
      optional: true
      addresses:
        - 192.168.42.3/24

  wifis:
    wlan0:
      optional: true
      access-points:
        'SALA-GRIFFIN-5G':
          password: "<WIFI_PASSWORD>"
      dhcp4: true
      dhcp4-overrides:
        route-metric: 200
