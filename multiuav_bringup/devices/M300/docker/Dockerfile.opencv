ARG IMAGE_NAME=nvcr.io/nvidia/l4t-jetpack:r36.4.0

FROM ${IMAGE_NAME}

ARG DEBIAN_FRONTEND=noninteractive
ARG OPENCV_VERSION=4.8.1
ARG CUDA_ARCH_BIN=8.7

ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=Europe/Madrid
ENV NVIDIA_DRIVER_CAPABILITIES=${NVIDIA_DRIVER_CAPABILITIES:+$NVIDIA_DRIVER_CAPABILITIES,}compute,video,utility

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    pkg-config \
    python3 \
    python3-dev \
    python3-pip \
    python3-numpy \
    libgtk-3-dev \
    libpng-dev \
    libjpeg-dev \
    libtiff-dev \
    libdc1394-dev \
    libeigen3-dev \
    libatlas-base-dev \
    liblapack-dev \
    libopenblas-dev \
    gfortran \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-good1.0-dev \
    libv4l-dev \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    && rm -rf /var/lib/apt/lists/*

# Desinstalar OpenCV sin CUDA que viene preinstalado en L4T
RUN apt-get remove -y libopencv* opencv-* nvidia-opencv* || true && \
    apt-get autoremove -y && \
    rm -rf /var/lib/apt/lists/*

RUN cd /tmp && \
    git clone --branch ${OPENCV_VERSION} --depth 1 https://github.com/opencv/opencv.git && \
    git clone --branch ${OPENCV_VERSION} --depth 1 https://github.com/opencv/opencv_contrib.git

# Patch cudev: sintaxis GNU incompatible con NVCC/CUDA 12 + Thrust en Jetson Orin (sm_87)
RUN sed -i \
    's/__attribute__((device)) __inline__ __attribute__((always_inline))/__forceinline__ __device__/g' \
    /tmp/opencv_contrib/modules/cudev/include/opencv2/cudev/block/reduce.hpp

# libcuda.so en Jetson está en tegra/, no en el path estándar — se pasa directo a cmake
RUN mkdir /tmp/opencv/build && cd /tmp/opencv/build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DOPENCV_EXTRA_MODULES_PATH=/tmp/opencv_contrib/modules \
        -DWITH_CUDA=ON \
        -DCUDA_ARCH_BIN=${CUDA_ARCH_BIN} \
        -DCUDA_ARCH_PTX="" \
        -DWITH_CUDNN=ON \
        -DOPENCV_DNN_CUDA=ON \
        -DWITH_CUBLAS=ON \
        -DWITH_GSTREAMER=ON \
        -DWITH_LIBV4L=ON \
        -DWITH_FFMPEG=ON \
        -DBUILD_opencv_python3=ON \
        -DPYTHON3_EXECUTABLE=/usr/bin/python3 \
        -DBUILD_TESTS=OFF \
        -DBUILD_PERF_TESTS=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_JAVA=OFF \
        -DBUILD_opencv_cudacodec=OFF && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    rm -rf /tmp/opencv /tmp/opencv_contrib

ENV OpenCV_DIR=/usr/local/lib/cmake/opencv4

WORKDIR /root
CMD ["bash"]
