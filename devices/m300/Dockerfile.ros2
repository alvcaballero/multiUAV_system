ARG IMAGE_NAME=opencv-cuda:l4t-r36.4.0

FROM ${IMAGE_NAME}

ARG DEBIAN_FRONTEND=noninteractive
ARG ROS2_DISTRO=humble

ENV ROS_DISTRO=${ROS2_DISTRO}
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV TZ=Europe/Madrid
ENV NVIDIA_DRIVER_CAPABILITIES=${NVIDIA_DRIVER_CAPABILITIES:+$NVIDIA_DRIVER_CAPABILITIES,}compute,video,utility

RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Base tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    gnupg2 \
    lsb-release \
    build-essential \
    cmake \
    git \
    nano \
    sudo \
    software-properties-common \
    python3 \
    python3-dev \
    python3-pip \
    python3-setuptools \
    libusb-1.0-0-dev \
    libeigen3-dev \
    libboost-all-dev \
    libyaml-cpp-dev \
    libssl-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-good1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    libgstrtspserver-1.0-dev \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-rtsp \
    ffmpeg \
    libavcodec-dev \
    libavformat-dev \
    libavutil-dev \
    libswscale-dev \
    libswresample-dev \
    libavfilter-dev \
    && rm -rf /var/lib/apt/lists/*

# ROS 2 Humble — apt install directo (L4T r36 = Ubuntu 22.04 Jammy)
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
    > /etc/apt/sources.list.d/ros2.list


RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-ros-base \
    ros-humble-ament-cmake \
    ros-humble-ament-cmake-python \
    ros-humble-rclcpp \
    ros-humble-rclpy \
    ros-humble-std-msgs \
    ros-humble-geometry-msgs \
    ros-humble-sensor-msgs \
    ros-humble-nav-msgs \
    ros-humble-tf2 \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    ros-humble-image-transport \
    ros-humble-cv-bridge \
    ros-humble-vision-opencv \
    ros-humble-diagnostic-msgs \
    ros-humble-geographic-msgs \
    ros-humble-nmea-msgs \
    ros-humble-rosbag2 \
    ros-humble-rosbag2-storage-default-plugins 

RUN echo "source /opt/ros/humble/setup.bash" >> /root/.bashrc

# install bootstrap tools
RUN apt-get update && apt-get install --no-install-recommends -y \
    build-essential \
    git \
    python3-colcon-common-extensions \
    python3-colcon-mixin \
    python3-rosdep \
    python3-vcstool \
    && rm -rf /var/lib/apt/lists/*

# rosdep necesita pkg_resources: pin setuptools ANTES de ejecutarlo.
# El rango >=77.0.1,<80 satisface grpcio-tools (>=7 7.0.1) y colcon (<80).
# setuptools>=80 eliminó pkg_resources y rompe rosdep/colcon.
RUN pip3 install --no-cache-dir "setuptools>=77.0.1,<80.0.0" && \
    pip3 cache purge

RUN rosdep init || echo "rosdep already initialized." && \
    rosdep update

# Source ROS antes de pip para que las deps queden en el mismo sys.path
# que usa el entorno ROS (/opt/ros/humble/local/lib/python3.10/dist-packages).
RUN bash -c "source /opt/ros/humble/setup.bash && \
    pip3 install --no-cache-dir \
        numpy \
        pyyaml \
        grpcio \
        grpcio-tools \
        psutil \
        paramiko"



WORKDIR /root
CMD ["bash"]
