# ROS 1 Noetic DESDE FUENTES para el Jetson (L4T r36.4 = Ubuntu 22.04: Noetic no tiene apt para Jammy).
# Lo importa osdk/Dockerfile.ros1. Antes eran ~40 `git clone` dentro del Dockerfile, varios por RAMA: ahora todo fijado
# (decisión 12). Los que tenían tag lo conservan; los que iban por rama están en el commit de esa rama al
# 2026-10-31 (indicado en el comentario).
# Las claves son los nombres de directorio que creaba `git clone`: Dockerfile.ros1 mueve src/image_transport_plugins.
repositories:
  actionlib:              {type: git, url: https://github.com/ros/actionlib.git,              version: 1.14.0}
  bond_core:              {type: git, url: https://github.com/ros/bond_core.git,              version: 1.8.6}
  catkin:                 {type: git, url: https://github.com/ros/catkin.git,                 version: 0.8.10}
  class_loader:           {type: git, url: https://github.com/ros/class_loader.git,           version: 0.5.0}
  cmake_modules:          {type: git, url: https://github.com/ros/cmake_modules.git,          version: 0.5.0}
  common_msgs:            {type: git, url: https://github.com/ros/common_msgs.git,            version: 1.13.1}
  dynamic_reconfigure:    {type: git, url: https://github.com/ros/dynamic_reconfigure.git,    version: 1.7.3}
  gencpp:                 {type: git, url: https://github.com/ros/gencpp.git,                 version: 0.7.0}
  geneus:                 {type: git, url: https://github.com/jsk-ros-pkg/geneus.git,         version: 3.0.0}
  genlisp:                {type: git, url: https://github.com/ros/genlisp.git,                version: 0.4.18}
  genmsg:                 {type: git, url: https://github.com/ros/genmsg.git,                 version: 0.6.0}
  gennodejs:              {type: git, url: https://github.com/RethinkRobotics-opensource/gennodejs.git, version: 2.0.1}
  genpy:                  {type: git, url: https://github.com/ros/genpy.git,                  version: 0.6.16}
  message_generation:     {type: git, url: https://github.com/ros/message_generation.git,     version: 0.4.1}
  message_runtime:        {type: git, url: https://github.com/ros/message_runtime.git,        version: 0.4.13}
  nodelet_core:           {type: git, url: https://github.com/ros/nodelet_core.git,           version: 1.10.2}
  pluginlib:              {type: git, url: https://github.com/ros/pluginlib.git,              version: 1.13.0}
  ros:                    {type: git, url: https://github.com/ros/ros.git,                    version: 1.15.8}
  ros_comm:               {type: git, url: https://github.com/ros/ros_comm.git,               version: 1.16.0}
  ros_comm_msgs:          {type: git, url: https://github.com/ros/ros_comm_msgs.git,          version: 1.11.3}
  ros_environment:        {type: git, url: https://github.com/ros/ros_environment.git,        version: 1.3.2}
